  eventName: InternalConflictEvent
  prompt: "\u9577\u3044\u9589\u9396\u751F\u6D3B\u306E\u4E2D\u3067\u3001\u30B7\u30A7\u30EB\u30BF\u30FC\u5185\u306E\u4E9B\u7D30\u306A\u610F\u898B\u306E\u76F8\u9055\u304C\u5F90\u3005\u306B\u5927\u304D\u306A\u5BFE\u7ACB\u3078\u3068\u767A\u5C55\u3057\u3066\u3044\u308B\u3002\u5185\u90E8\u306E\u6DF7\u4E71\u306F\u7269\u8CC7\u7BA1\u7406\u3084\u5B89\u5168\u5BFE\u7B56\u306B\u3082\u5F71\u97FF\u3092\u4E0E\u3048\u308B\u6050\u308C\u304C\u3042\u308B\u3002\u3053\u3053\u3089\u8FBA\u3067\u4E00\u65E6\u548C\u89E3\u3092\u7533\u3057\u51FA\u308B\u3079\u304D\u3060\u308D\u3046\u304B\uFF1F"
  yesOutcome: "\u548C\u89E3\u3092\u63D0\u6848\u3057\u3001\u5BFE\u8A71\u3068\u59A5\u5354\u3092\u4FC3\u3057\u305F\u7D50\u679C\u3001\u5185\u90E8\u306E\u96F0\u56F2\u6C17\u304C\u6539\u5584\u3055\u308C\u305F\u3002\u3084\u306F\u308A\u3001\u3069\u3093\u306A\u3068\u304D\u3082\u67D4\u8EDF\u306B\u751F\u304D\u3066\u3044\u304F\u3068\u3044\u3046\u306E\u306F\u91CD\u8981\u3067\u3042\u308B\u3002\u982D\u304C\u5C11\u3057\u51B7\u9759\u306B\u306A\u3063\u3066\u3042\u305F\u308A\u3092\u898B\u6E21\u3059\u3068\u6CE8\u5C04\u5668\u3068\u30AC\u30FC\u30BC\u304C\u68DA\u306E\u5965\u304B\u3089\u898B\u3064\u304B\u3063\u305F\u3002"
  noOutcome: "\u3053\u3061\u3089\u304B\u3089\u8B1D\u308B\uFF1F\u81EA\u5206\u304C\u60AA\u304F\u306A\u3044\u306E\u306B\u4F55\u6545\u305D\u3093\u306A\u99AC\u9E7F\u3052\u305F\u884C\u52D5\u3092\u53D6\u308B\u5FC5\u8981\u304C\u3042\u308B\u3093\u3060\uFF1F\u3053\u306E\u4E16\u306F\u5927\u30B7\u30A7\u30EB\u30BF\u30FC\u6642\u4EE3\u306A\u306E\u3060\u3002\u3053\u3053\u306E\u4E3B\u5C0E\u6A29\u306F\u7D76\u5BFE\u306B\u8B72\u308B\u308F\u3051\u306B\u306F\u884C\u304B\u306A\u3044\uFF01"

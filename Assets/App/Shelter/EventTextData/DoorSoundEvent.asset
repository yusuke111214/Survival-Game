  eventName: DoorSoundEvent
  prompt: "\u6DF1\u591C\u3001\u30B7\u30A7\u30EB\u30BF\u30FC\u306E\u6249\u4ED8\u8FD1\u304B\u3089\u91D1\u5C5E\u304C\u3076\u3064\u304B\u308B\u3088\u3046\u306A\u97F3\u304C\u65AD\u7D9A\u7684\u306B\u97FF\u3044\u3066\u3044\u308B\u3002\u97F3\u306E\u6B63\u4F53\u306F\u5206\u304B\u3089\u306A\u3044\u304C\u3001\u5916\u90E8\u304B\u3089\u306E\u4FB5\u5165\u304B\u3001\u6551\u63F4\u306E\u5146\u5019\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u6249\u3092\u958B\u3051\u3001\u72B6\u6CC1\u3092\u78BA\u8A8D\u3057\u307E\u3059\u304B\uFF1F"
  yesOutcome: "\u6249\u3092\u958B\u3051\u305F\u3068\u3053\u308D\u3001\u8584\u6697\u3044\u5916\u3067\u6551\u63F4\u7269\u8CC7\u3092\u904B\u3076\u8ECA\u306E\u5F71\u304C\u898B\u3048\u305F\u3002\u3057\u304B\u3057\u3001\u305D\u306E\u76F4\u5F8C\u3001\u611F\u67D3\u8005\u3089\u3057\u304D\u4EBA\u7269\u306E\u52D5\u304D\u3082\u78BA\u8A8D\u3055\u308C\u3001\u30EA\u30B9\u30AF\u3082\u4F34\u3046\u7D50\u679C\u3068\u306A\u3063\u305F\u3002\u7269\u8CC7\u306F\u4E00\u90E8\u53D7\u3051\u53D6\u308C\u305F\u304C\u3001\u30B7\u30A7\u30EB\u30BF\u30FC\u5185\u306B\u75C5\u539F\u83CC\u304C\u4FB5\u5165\u3057\u3066\u3057\u307E\u3063\u305F\u3002"
  noOutcome: "\u6249\u3092\u958B\u3051\u305A\u306B\u69D8\u5B50\u3092\u898B\u5B88\u308B\u3053\u3068\u306B\u3057\u305F\u3002\u3082\u3057\u304B\u3059\u308B\u3068\u6551\u63F4\u7269\u8CC7\u304C\u8CB0\u3048\u305F\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u3057\u304B\u3057\u3001\u6211\u3005\u306F\u4E0D\u7528\u610F\u306A\u63A5\u89E6\u3092\u907F\u3051\u305F\u305F\u3081\u3001\u3001\u611F\u67D3\u30EA\u30B9\u30AF\u306F\u6291\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u305F\u3060\u308D\u3046\u3002"

  prompt: "\u8ECD\u306E\u95A2\u4FC2\u8005\u304B\u3089\u30A6\u30A4\u30EB\u30B9\u306E\u6025\u901F\u306A\u62E1\u5927\u306B\u5BFE\u6297\u3059\u308B\u305F\u3081\u3001\u30EF\u30AF\u30C1\u30F3\u958B\u767A\u306B\u5354\u529B\u3057\u3066\u307B\u3057\u3044\u3068\u306E\u8981\u8ACB\u304C\u5C4A\u3044\u305F\u3002\u5354\u529B\u3059\u308C\u3070\u3001\u5BB6\u65CF\u306E\u672A\u6765\u306B\u660E\u308B\u3044\u5E0C\u671B\u304C\u898B\u3048\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u304C\u3001\u30EA\u30B9\u30AF\u3082\u4F34\u3046\u3002\u6211\u3005\u306F\u5354\u529B\u3057\u307E\u3059\u304B\uFF1F"
  yesOutcome: "\u8ECD\u306E\u8981\u8ACB\u306B\u5FDC\u3058\u3001\u5468\u56F2\u306E\u751F\u5B58\u8005\u3068\u9023\u643A\u3057\u3066\u30EF\u30AF\u30C1\u30F3\u306E\u7814\u7A76\u3092\u9032\u3081\u305F\u7D50\u679C\u3001\u521D\u671F\u306E\u6CBB\u7642\u6CD5\u304C\u78BA\u7ACB\u3055\u308C\u308B\u53EF\u80FD\u6027\u304C\u51FA\u305F\u3002\u3057\u304B\u3057\u3001\u4E00\u90E8\u306E\u8CC7\u6E90\u304C\u7814\u7A76\u306B\u6295\u5165\u3055\u308C\u305F\u305F\u3081\u3001\u65E5\u5E38\u751F\u6D3B\u306E\u7269\u8CC7\u304C\u4E00\u6642\u4E0D\u8DB3\u3059\u308B\u7D50\u679C\u306B\u3082\u3064\u306A\u304C\u3063\u305F\u3002"
  noOutcome: "\u3053\u3093\u306A\u3054\u6642\u4E16\u3067\u8ECD\u306E\u95A2\u4FC2\u8005\u3060\u3068\uFF1F\u3069\u3046\u3084\u3063\u3066\u4FE1\u3058\u308C\u3070\u3044\u3044\u3093\u3060\u3002\u4F55\u304C\u8D77\u3053\u308B\u304B\u3082\u308F\u304B\u3089\u306A\u3044\u4ECA\u306F\u305F\u3060\u3058\u3063\u3068\u6642\u304C\u6765\u308B\u306E\u3092\u5F85\u3064\u3057\u304B\u306A\u3044\u306E\u3060\u3002"

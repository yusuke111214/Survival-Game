  eventName: InfectedApproachEvent
  prompt: "\u5916\u306E\u8584\u6697\u3044\u666F\u8272\u306E\u4E2D\u3001\u611F\u67D3\u8005\u3068\u898B\u3089\u308C\u308B\u5F71\u304C\u30B7\u30A7\u30EB\u30BF\u30FC\u8FD1\u304F\u3092\u3046\u308D\u3064\u3044\u3066\u3044\u308B\u306E\u304C\u78BA\u8A8D\u3055\u308C\u305F\u3002\u3053\u308C\u306F\u5373\u6642\u306E\u5BFE\u5FDC\u304C\u5FC5\u8981\u306A\u306E\u304B\u3001\u305D\u308C\u3068\u3082\u69D8\u5B50\u3092\u898B\u308B\u3079\u304D\u304B\u3001\u5224\u65AD\u306B\u8FF7\u3046\u72B6\u6CC1\u3060\u3002\u6211\u3005\u306F\u5373\u5EA7\u306B\u5BFE\u7B56\u3092\u8B1B\u3058\u308B\u3079\u304D\u3060\u308D\u3046\u304B\uFF1F"
  yesOutcome: "\u5BB6\u65CF\u5168\u54E1\u3067\u5373\u5EA7\u306B\u9632\u8B77\u7B56\u3092\u8B1B\u3058\u305F\u7D50\u679C\u3001\u611F\u67D3\u306E\u62E1\u5927\u3092\u306B\u6291\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u305F\u304C\u3001\u5FC3\u304C\u5C11\u3057\u50B7\u3093\u3060\u3002\u540C\u3058\u4EBA\u9593\u3068\u3044\u3048\u3069\u3042\u306E\u60AA\u9B54\u306E\u3088\u3046\u306A\u30A6\u30A4\u30EB\u30B9\u306B\u611F\u67D3\u3057\u3066\u3044\u308B\u306A\u3089\u8A71\u306F\u5225\u3060\u3002"
  noOutcome: "\u72B6\u6CC1\u3092\u5C11\u3057\u898B\u5B88\u3063\u305F\u7D50\u679C\u3001\u3069\u3046\u3084\u3089\u8ECD\u306E\u95A2\u4FC2\u8005\u304C\u611F\u67D3\u3057\u3066\u3044\u305F\u3088\u3046\u3060\u3002\u6211\u3005\u306E\u533B\u7642\u54C1\u3092\u7528\u3044\u3066\u6CBB\u7642\u3092\u3057\u3066\u3042\u3052\u308B\u3068\u3001\u3068\u3066\u3082\u559C\u3093\u3060\u69D8\u5B50\u3067\u5FC3\u304C\u6E29\u304B\u304F\u306A\u3063\u305F\u3002\u305D\u306E\u304A\u793C\u3068\u3057\u3066\u9053\u4E2D\u62FE\u3063\u305F\u3068\u3044\u3046\u6C34\u306E\u30DC\u30C8\u30EB\u3092\u8CB0\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u305F\u3002"

  prompt: "\u5076\u7136\u306B\u3082\u3001\u30B7\u30A7\u30EB\u30BF\u30FC\u306E\u5468\u8FBA\u306B\u3001\u304B\u3064\u3066\u8AB0\u304B\u304C\u96A0\u3057\u3066\u3044\u305F\u3068\u601D\u308F\u308C\u308B\u7269\u8CC7\u306E\u75D5\u8DE1\u304C\u767A\u898B\u3055\u308C\u305F\u3002\u3053\u308C\u3092\u63A2\u7D22\u3059\u308C\u3070\u5927\u3044\u306B\u52A9\u304B\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u304C\u3001\u5371\u967A\u3082\u4F34\u3046\u3002\u63A2\u7D22\u306B\u8E0F\u307F\u5207\u308A\u307E\u3059\u304B\uFF1F"
  yesOutcome: "\u63A2\u7D22\u306B\u4E57\u308A\u51FA\u3057\u305F\u7D50\u679C\u3001\u3001\u63A2\u7D22\u4E2D\u306B\u4E00\u90E8\u611F\u67D3\u306E\u30EA\u30B9\u30AF\u3092\u4F34\u3046\u74B0\u5883\u306B\u63A5\u89E6\u3057\u3001\u30A6\u30A4\u30EB\u30B9\u306E\u4FB5\u5165\u3092\u8A31\u3057\u3066\u3057\u307E\u3063\u305F\u3002"
  noOutcome: "\u63A2\u7D22\u3092\u63A7\u3048\u305F\u7D50\u679C\u3001\u5B89\u5FC3\u3057\u3066\u30B7\u30A7\u30EB\u30BF\u30FC\u5185\u306B\u7559\u307E\u308B\u3053\u3068\u304C\u3067\u304D\u305F\u3002\u30D0\u30C3\u30B0\u3092\u6574\u7406\u3057\u3066\u3044\u308B\u3068\u30DD\u30B1\u30C3\u30C8\u306E\u4E2D\u306B\u975E\u5E38\u7528\u306E\u6C34\u304C\u5165\u3063\u3066\u3044\u305F\u3002"

  eventName: PowerOutageEvent
  prompt: "\u30B7\u30A7\u30EB\u30BF\u30FC\u5185\u3067\u7A81\u7136\u3001\u7167\u660E\u304C\u843D\u3061\u3001\u5BB6\u65CF\u306B\u30D1\u30CB\u30C3\u30AF\u304C\u8D77\u3053\u3063\u305F\u3002\u505C\u96FB\u306F\u5B8C\u5168\u3067\u306F\u306A\u304F\u3001\u4E00\u90E8\u975E\u5E38\u706F\u306F\u70B9\u706F\u3057\u3066\u3044\u308B\u304C\u3001\u4E0D\u5B89\u304C\u52DF\u308B\u72B6\u6CC1\u3060\u3002\u6211\u3005\u306F\u3059\u3050\u306B\u975E\u5E38\u7528\u767A\u96FB\u88C5\u7F6E\u3092\u8D77\u52D5\u3055\u305B\u308B\u304B\uFF1F"
  yesOutcome: "\u8FC5\u901F\u306B\u975E\u5E38\u7528\u767A\u96FB\u88C5\u7F6E\u3092\u8D77\u52D5\u3057\u305F\u7D50\u679C\u3001\u7167\u660E\u306F\u5FA9\u65E7\u3057\u305F\uFF01\u8D77\u52D5\u306E\u305F\u3081\u306B\u5954\u8D70\u3057\u3066\u3044\u308B\u3068\u304D\u306B\u30B7\u30A7\u30EB\u30BF\u30FC\u306E\u4E2D\u3067\u98DF\u6599\u3092\u767A\u898B\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u305F\uFF01"
  noOutcome: "\u975E\u5E38\u7528\u767A\u96FB\u88C5\u7F6E\u306E\u8D77\u52D5\u3092\u898B\u9001\u3063\u305F\u7D50\u679C\u3001\u505C\u96FB\u72B6\u614B\u306F\u9577\u5F15\u304D\u3001\u6211\u3005\u306F\u4E0D\u5B89\u306A\u591C\u3092\u904E\u3054\u3057\u305F\u3002\u3057\u304B\u3057\u3001\u5F8C\u306B\u96FB\u6C17\u306E\u4F9B\u7D66\u304C\u518D\u958B\u3055\u308C\u305F\u306E\u3067\u4E0D\u8981\u306A\u52B4\u529B\u3092\u8CBB\u3084\u3055\u305A\u306B\u6E08\u3093\u3067\u826F\u304B\u3063\u305F\u3068\u8A00\u3048\u308B\u3060\u308D\u3046\u3002"

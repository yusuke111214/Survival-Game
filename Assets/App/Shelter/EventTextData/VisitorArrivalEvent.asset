  prompt: "\u7A81\u7136\u3001\u30B7\u30A7\u30EB\u30BF\u30FC\u306E\u5468\u8FBA\u306B\u8B0E\u306E\u96C6\u56E3\u304C\u73FE\u308C\u305F\u3002\u5F7C\u3089\u306F\u7269\u8CC7\u3092\u6C42\u3081\u308B\u7565\u596A\u8005\u3068\u3082\u3001\u9006\u306B\u6551\u63F4\u306E\u624B\u3092\u5DEE\u3057\u4F38\u3079\u308B\u5354\u529B\u8005\u3068\u3082\u89E3\u91C8\u3067\u304D\u308B\u3002\u5F7C\u3089\u3068\u63A5\u89E6\u3092\u8A66\u307F\u307E\u3059\u304B\uFF1F"

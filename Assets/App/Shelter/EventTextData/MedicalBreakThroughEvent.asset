  eventName: MedicalBreakthroughEvent
  prompt: "\u5076\u7136\u306B\u3082\u3001\u30A6\u30A4\u30EB\u30B9\u306E\u6CBB\u7642\u6CD5\u3084\u30EF\u30AF\u30C1\u30F3\u958B\u767A\u306E\u9375\u3068\u306A\u308B\u53EF\u80FD\u6027\u306E\u3042\u308B\u533B\u7642\u60C5\u5831\u304C\u3082\u305F\u3089\u3055\u308C\u305F\u3002\u3057\u304B\u3057\u3001\u305D\u306E\u60C5\u5831\u306F\u65AD\u7247\u7684\u3067\u89E3\u91C8\u304C\u96E3\u3057\u304F\u3001\u691C\u8A3C\u304C\u5FC5\u8981\u3060\u3002\u3053\u306E\u60C5\u5831\u3092\u7CBE\u67FB\u3057\u307E\u3059\u304B\uFF1F"
  yesOutcome: "\u533B\u7642\u60C5\u5831\u3092\u7CBE\u67FB\u3057\u3001\u5C02\u9580\u5BB6\u3068\u9023\u643A\u3057\u3066\u89E3\u8AAD\u3092\u8A66\u307F\u305F\u7D50\u679C\u3001\u6CBB\u7642\u6CD5\u306E\u4E00\u7AEF\u304C\u660E\u3089\u304B\u306B\u306A\u308A\u3001\u5BB6\u65CF\u306E\u611F\u67D3\u30EA\u30B9\u30AF\u4F4E\u6E1B\u306B\u5411\u3051\u305F\u5177\u4F53\u7684\u5BFE\u7B56\u304C\u6253\u305F\u308C\u305F\u3002\u3057\u304B\u3057\u3001\u60C5\u5831\u89E3\u6790\u306B\u6642\u9593\u3068\u8CC7\u6E90\u3092\u5272\u3044\u3066\u3057\u307E\u3046\u7D50\u679C\u3068\u306A\u3063\u305F\u3002"
  noOutcome: "\u60C5\u5831\u306E\u7CBE\u67FB\u3092\u898B\u9001\u308A\u3001\u73FE\u72B6\u7DAD\u6301\u306B\u52AA\u3081\u305F\u7D50\u679C\u3001\u76F4\u8FD1\u306E\u6DF7\u4E71\u306F\u56DE\u907F\u3067\u304D\u305F\u304C\u3001\u5F8C\u65E5\u3001\u540C\u3058\u60C5\u5831\u304C\u518D\u3073\u63D0\u793A\u3055\u308C\u305F\u969B\u306B\u6CBB\u7642\u6CD5\u306E\u78BA\u7ACB\u306B\u5927\u304D\u304F\u8CA2\u732E\u3067\u304D\u306A\u304B\u3063\u305F\u3068\u3044\u3046\u5F8C\u6094\u304C\u6B8B\u3063\u305F\u3002"

  eventName: RadioBroadcastEvent
  prompt: "\u53E4\u3073\u305F\u30E9\u30B8\u30AA\u304B\u3089\u3001\u653F\u5E9C\u306E\u7DCA\u6025\u767A\u8868\u3068\u3082\u53D6\u308C\u308B\u304C\u3001\u5185\u5BB9\u304C\u65AD\u7247\u7684\u306A\u7121\u7DDA\u653E\u9001\u304C\u6D41\u308C\u3066\u3044\u308B\u3002\u5185\u5BB9\u306F\u300E\u2026\u6551\u63F4\u7269\u8CC7\u2026\u5C01\u9396\u2026\u5BFE\u7B56\u2026\u300F\u3068\u65AD\u7247\u7684\u3060\u3002\u6211\u3005\u306F\u305D\u306E\u60C5\u5831\u3092\u4FE1\u3058\u3001\u884C\u52D5\u306B\u79FB\u3059\u304B\uFF1F"
  yesOutcome: "\u60C5\u5831\u306B\u5F93\u3044\u3001\u30B7\u30A7\u30EB\u30BF\u30FC\u5185\u306E\u9632\u8B77\u5BFE\u7B56\u3092\u5F37\u5316\u3057\u305F\u7D50\u679C\u3001\u4E00\u90E8\u306E\u5BB6\u65CF\u306F\u611F\u67D3\u30EA\u30B9\u30AF\u3092\u8EFD\u6E1B\u3067\u304D\u305F\u3002\u3057\u304B\u3057\u3001\u60C5\u5831\u306E\u4FE1\u6191\u6027\u304C\u4F4E\u304B\u3063\u305F\u305F\u3081\u3001\u7269\u8CC7\u8ABF\u9054\u306E\u30BF\u30A4\u30DF\u30F3\u30B0\u3092\u9038\u3057\u3001\u5F8C\u306B\u6551\u63F4\u7269\u8CC7\u304C\u5C4A\u304F\u306E\u304C\u9045\u308C\u305F\u3053\u3068\u304C\u5206\u304B\u3063\u305F\u3002"
  noOutcome: "\u7121\u7DDA\u653E\u9001\u3092\u7591\u3044\u3001\u7279\u306B\u5BFE\u7B56\u3092\u53D6\u3089\u306A\u304B\u3063\u305F\u304C\u3001\u305D\u306E\u5F8C\u3001\u5B9F\u969B\u306B\u653F\u5E9C\u304C\u6551\u63F4\u7269\u8CC7\u306E\u4F9B\u7D66\u3092\u958B\u59CB\u3057\u305F\u60C5\u5831\u304C\u5165\u3063\u305F\u3002\u30BF\u30A4\u30DF\u30F3\u30B0\u3092\u9003\u3057\u305F\u3053\u3068\u3078\u306E\u5F8C\u6094\u3068\u3001\u5BFE\u7B56\u304C\u4E0D\u5341\u5206\u3060\u3063\u305F\u3068\u3044\u3046\u4E0D\u5B89\u304C\u6B8B\u3063\u305F\u3002"

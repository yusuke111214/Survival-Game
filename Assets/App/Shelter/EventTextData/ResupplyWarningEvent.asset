  eventName: ResupplyWarningEvent
  prompt: "\u5916\u90E8\u304B\u3089\u6551\u63F4\u7269\u8CC7\u304C\u904B\u3070\u308C\u3066\u304F\u308B\u3068\u306E\u60C5\u5831\u304C\u5165\u3063\u305F\u304C\u3001\u540C\u6642\u306B\u8F38\u9001\u8DEF\u306E\u6DF7\u4E71\u3084\u6575\u5BFE\u52E2\u529B\u306E\u52D5\u304D\u3082\u5831\u544A\u3055\u308C\u3066\u3044\u308B\u3002\u72B6\u6CC1\u306F\u4E00\u7B4B\u7E04\u3067\u306F\u3044\u304B\u306A\u3044\u3002\u6211\u3005\u306F\u7A4D\u6975\u7684\u306B\u7269\u8CC7\u53D7\u3051\u5165\u308C\u306E\u6E96\u5099\u3092\u9032\u3081\u307E\u3059\u304B\uFF1F"
  yesOutcome: "\u7A4D\u6975\u7684\u306B\u53D7\u3051\u5165\u308C\u6E96\u5099\u3092\u6574\u3048\u305F\u7D50\u679C\u3001\u8F38\u9001\u306E\u9053\u4E2D\u3067\u7269\u8CC7\u304C\u30A6\u30A4\u30EB\u30B9\u306B\u6C5A\u67D3\u3055\u308C\u305F\u3068\u3044\u3046\u60C5\u5831\u304C\u5165\u3063\u305F\u3002\u52AA\u529B\u306F\u6642\u306B\u6211\u3005\u3092\u88CF\u5207\u308B\u3068\u3044\u3046\u3053\u3068\u3082\u5FD8\u308C\u3066\u306F\u3044\u3051\u306A\u3044\u3002"
  noOutcome: "\u6E96\u5099\u3092\u898B\u9001\u308B\u3053\u3068\u306B\u3057\u305F\u3002\u4ECA\u306F\u4F55\u3088\u308A\u3082\u5BB6\u65CF\u5185\u306E\u8ABF\u548C\u3092\u512A\u5148\u3059\u308B\u3079\u304D\u3060\u3002\u4E45\u3057\u3076\u308A\u306B\u3044\u308D\u3044\u308D\u8A71\u3057\u3066\u3044\u308B\u5185\u306B\u30B7\u30A7\u30EB\u30BF\u30FC\u306E\u4E2D\u306B\u57C3\u3092\u88AB\u3063\u305F\u533B\u7642\u54C1\u304C\u7720\u3063\u3066\u3044\u305F\u3002"
